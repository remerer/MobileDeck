    <string name="classic_tutorial_title">Classic UI basics</string>
    <string name="classic_tutorial_subtitle">Use MobileDeck as a phone-sized macro pad for your PC.</string>
    <string name="classic_tutorial_connect_title">Set up the PC connection first</string>
    <string name="classic_tutorial_connect_body">Bluetooth keyboard mode can handle basic key input and media keys by itself. Connect Companion when you want expanded PC commands and live values.</string>
    <string name="classic_tutorial_connect_body_release">Bluetooth keyboard mode sends basic key input, shortcuts, and media keys to the paired PC.</string>
    <string name="classic_tutorial_order_register">Tap Register Bluetooth keyboard.</string>
    <string name="classic_tutorial_order_discoverable">Turn on Allow PC pairing.</string>
    <string name="classic_tutorial_order_pair_pc">Pair "MobileDeck Keyboard" from the PC Bluetooth screen.</string>
    <string name="classic_tutorial_connect_detail_companion">Companion expands what the deck can do: QR pair it for PC commands, app control, and live values.</string>
    <string name="classic_tutorial_connect_detail_bluetooth">Bluetooth HID alone still supports basic keyboard input, shortcuts, and media keys.</string>
    <string name="classic_tutorial_connect_detail_status">Use the status dots to confirm whether Companion or Bluetooth is currently connected.</string>
    <string name="classic_tutorial_connect_detail_status_release">Use the status dot to confirm whether Bluetooth is currently connected.</string>
    <string name="classic_tutorial_ui_mode_title">Choose Classic or Console UI</string>
    <string name="classic_tutorial_ui_mode_body">Use the UI switch at the top of the left panel to choose the editing style before tuning the deck.</string>
    <string name="classic_tutorial_ui_mode_detail_classic">Classic UI uses compact setting boxes, solid buttons, and grid-based button sizes.</string>
    <string name="classic_tutorial_ui_mode_detail_console">Console UI uses a sidebar, row-based layout, and console-style button cards.</string>
    <string name="classic_tutorial_ui_mode_detail_settings">Each UI keeps its own visual settings while sharing the same deck actions.</string>
    <string name="classic_tutorial_layout_title">Adjust deck layout</string>
    <string name="classic_tutorial_layout_body">Deck layout controls change the number of visible keys, spacing, page count, page direction, and page swipe behavior.</string>
    <string name="classic_tutorial_layout_detail_grid">Set columns, rows, and spacing first so the deck matches your phone screen.</string>
    <string name="classic_tutorial_layout_detail_pages">Add pages when one screen is not enough; page buttons can also move between pages.</string>
    <string name="classic_tutorial_layout_detail_swipe">Choose horizontal, vertical, or disabled swiping depending on how you hold the device.</string>
    <string name="classic_tutorial_button_settings_title">Edit button behavior</string>
    <string name="classic_tutorial_button_settings_body">Button settings opens the button editor, where each key can be moved, deleted, and assigned a shortcut, media key, app command, text, run command, icon, or image.</string>
    <string name="classic_tutorial_buttons_detail_editor">Open the button editor to change title, subtitle, icon, image, color, and placement.</string>
    <string name="classic_tutorial_buttons_detail_actions">Key input supports media keys, hotkeys, text, run commands, app commands, and Companion-only commands.</string>
    <string name="classic_tutorial_buttons_detail_actions_release">Key input supports media keys, hotkeys, text, run commands, and app commands.</string>
    <string name="classic_tutorial_buttons_detail_controls">Control buttons include sliders, knobs, wheels, toggles, D-pads, and analog sticks when continuous input fits better than a tap.</string>
    <string name="classic_tutorial_background_title">Set the deck background</string>
    <string name="classic_tutorial_background_body">Background settings control how the deck surface looks behind the buttons.</string>
    <string name="classic_tutorial_background_detail_color">Use a solid color when you want maximum readability.</string>
    <string name="classic_tutorial_background_detail_image">Use an image background when you want a themed deck; imported bundles can include image assets.</string>
    <string name="classic_tutorial_background_detail_theme">Dark and light themes keep separate contrast rules so buttons remain readable.</string>
    <string name="classic_tutorial_backup_title">Export, import, and test</string>
    <string name="classic_tutorial_backup_body">The app information area contains maintenance tools for moving or checking a deck.</string>
    <string name="classic_tutorial_backup_detail_export">Export creates a portable bundle with layout, button settings, and user image assets.</string>
    <string name="classic_tutorial_backup_detail_import">Import restores a bundle on another device without needing the original local image files.</string>
    <string name="classic_tutorial_backup_detail_test">Use the app information area for export, import, and replaying the tutorial.</string>
    <string name="classic_tutorial_settings_button_title">Return to Settings from the deck</string>
    <string name="classic_tutorial_settings_button_body">The main deck has a Settings button. Tap it any time to come back here and adjust Bluetooth, layout, buttons, and backgrounds.</string>
    <string name="classic_tutorial_settings_detail_location">The Settings key is kept on the deck so you can return here without Android navigation.</string>
    <string name="classic_tutorial_settings_detail_restore">If the Settings key is removed, MobileDeck can restore it from the app settings flow.</string>
    <string name="classic_tutorial_settings_detail_repeat">You can replay this tutorial later from the app information section.</string>
    <string name="console_tutorial_connect_title">Console UI PC connection</string>
    <string name="console_tutorial_connect_body">Console UI shows PC connection as cards, and uses Companion first when it is connected for PC commands and live values.</string>
    <string name="console_tutorial_connect_body_release">Console UI shows Bluetooth keyboard connection status and pairing controls as PC connection cards.</string>
    <string name="console_tutorial_connect_detail_companion">The Companion card handles QR scan, connection check, and deck sync in one place.</string>
    <string name="console_tutorial_connect_detail_bluetooth">Bluetooth remains part of the same PC connection flow when HID keyboard input is needed.</string>
    <string name="console_tutorial_connect_detail_status">Use the header and card status dots to confirm the current target.</string>
    <string name="console_tutorial_ui_mode_title">Console UI structure</string>
    <string name="console_tutorial_ui_mode_body">Console UI separates settings into a left category rail and right detail panel, using the same button-card rules as the main deck.</string>
    <string name="console_tutorial_ui_mode_detail_sidebar">Left buttons move between PC connection, layout, background, controls, and app sections.</string>
    <string name="console_tutorial_ui_mode_detail_cards">Right-side settings are built from console button cards and information cards.</string>
    <string name="console_tutorial_ui_mode_detail_shared">It shares deck actions with Classic UI while keeping Console-specific visual settings.</string>
    <string name="console_tutorial_layout_title">Console layout editing</string>
    <string name="console_tutorial_layout_body">Console layout is based on a sidebar and row-based deck, with separate layout and button modes.</string>
    <string name="console_tutorial_layout_detail_modes">Layout mode adjusts sidebar width and row height.</string>
    <string name="console_tutorial_layout_detail_rows">Button mode lets you drag button handles to insert buttons elsewhere.</string>
    <string name="console_tutorial_layout_detail_pages">Page add and movement controls sit below the preview.</string>
    <string name="console_tutorial_button_settings_title">Console button editing</string>
    <string name="console_tutorial_button_settings_body">Button editing adjusts input type, icon, display mode, and control shape using Console card rules.</string>
    <string name="console_tutorial_buttons_detail_insert">Buttons move by insertion rather than direct replacement.</string>
    <string name="console_tutorial_buttons_detail_editor">Key input help separates modifiers, text keys, special keys, and media keys.</string>
    <string name="console_tutorial_buttons_detail_shapes">Horizontal, square, and vertical buttons lay out their content differently by ratio.</string>
    <string name="console_tutorial_background_title">Console background and panel</string>
    <string name="console_tutorial_background_body">Console background settings align panel color, button contrast, and font size with the main deck.</string>
    <string name="console_tutorial_background_detail_panel">Panel options adjust sidebar and deck surface brightness and texture.</string>
    <string name="console_tutorial_background_detail_font">Font size can follow the system or use small, normal, or large.</string>
    <string name="console_tutorial_background_detail_theme">Light and dark themes share the same highlight and shadow rules.</string>
    <string name="console_tutorial_backup_title">Export and app management</string>
    <string name="console_tutorial_backup_body">App information contains deck transfer, tutorial replay, and app management tools.</string>
    <string name="console_tutorial_backup_detail_export">Export includes layout, button settings, and user image assets.</string>
    <string name="console_tutorial_backup_detail_import">Import restores the same deck on another device.</string>
    <string name="console_tutorial_backup_detail_debug">The tutorial can be replayed from the app information area.</string>
    <string name="console_tutorial_settings_button_title">Return to Settings from the deck</string>
    <string name="console_tutorial_settings_button_body">The Console deck keeps a Settings button, and it can be restored from app settings when needed.</string>
    <string name="console_tutorial_settings_detail_location">The Settings button is the Console deck entry point for PC connection and layout tuning.</string>
    <string name="console_tutorial_settings_detail_restore">If it is removed, MobileDeck can restore it from the settings flow.</string>
    <string name="console_tutorial_settings_detail_repeat">You can replay this tutorial later from the app information section.</string>
